generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Accommodation {
  id                String             @id @default(uuid())
  name              String
  description       String
  summary           String?
  type              String
  rating            Float              @default(0.0)
  reviewsCount      Int                @default(0)
  priceLevel        Int                @default(1)
  basePrice         Float?
  imageUrl          String?
  coverImageUrl     String?
  bookingUrl        String
  bookingComId      String?            // Booking.com hotel ID for affiliate links (e.g., "hotel-europe")
  // affiliateUrl computed via buildBookingUrl() in lib/affiliate.ts
  slug              String             @unique
  latitude          Float?
  longitude         Float?
  isPremium         Boolean            @default(false)
  isFeatured        Boolean            @default(false)
  typeId            String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  accommodationType AccommodationType? @relation(fields: [typeId], references: [id])
  locationTags      LocationTag[]      @relation("AccommodationToTags")
  amenities         Amenity[]          @relation("AccommodationToAmenities")
  reviews           Review[]

  @@index([type])
  @@index([priceLevel])
  @@index([typeId])
  @@index([slug])
  @@index([bookingComId])
}

model Review {
  id              String        @id @default(uuid())
  userId          String
  userName        String
  userPhoto       String?
  rating          Int
  comment         String
  accommodationId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accommodation   Accommodation @relation(fields: [accommodationId], references: [id])

  @@index([accommodationId])
  @@index([userId])
}

model AccommodationType {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  description    String?
  icon           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accommodations Accommodation[]
}

model LocationTag {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  description    String?
  icon           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accommodations Accommodation[] @relation("AccommodationToTags")
}

model Amenity {
  id             String          @id @default(uuid())
  name           String          @unique
  slug           String          @unique
  icon           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accommodations Accommodation[] @relation("AccommodationToAmenities")
}

model AffiliateClick {
  id              String   @id @default(uuid())
  partner         String   // e.g. "booking", "airalo", "kiwi", "localrent"
  page            String   // page path where the click occurred (e.g. "/", "/smjestaj/hotel-europe")
  accommodationId String?
  referrer        String?
  createdAt       DateTime @default(now())

  @@index([partner])
  @@index([createdAt])
  @@index([accommodationId])
}

model Payout {
  id        String   @id @default(uuid())
  partner   String   // e.g. "booking", "airalo", "kiwi"
  amount    Float    // Confirmed payout amount in EUR
  date      DateTime // Date of payout or statement
  notes     String?
  createdAt DateTime @default(now())

  @@index([partner])
  @@index([date])
}

